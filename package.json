{
  "name": "pi-committer",
  "version": "0.15.1",
  "description": "Conventional commit automation for the pi coding agent — auto-commits on goal completion with intelligent, subagent-generated messages",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "npm run typecheck && node --experimental-strip-types --test tests/unit.test.ts tests/worker-edge.test.ts",
    "test:e2e": "PI_COMMITTER_E2E=1 node --experimental-strip-types --test tests/e2e.test.ts",
    "test:all": "npm run typecheck && node --experimental-strip-types --test tests/*.test.ts",
    "benchmark": "node --experimental-strip-types --test tests/benchmark.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "author": "pi-committer contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tmonk/pi-committer.git"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "git",
    "conventional-commits",
    "automation"
  ],
  "dependencies": {
    "@earendil-works/pi-tui": "^0.84.1",
    "smol-toml": "^1.3.0",
    "typebox": "^1.3.12"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://github.com/tmonk/pi-committer/raw/main/screenshot.png"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@types/node": "^25.9.5",
    "typescript": "^5.9.3"
  }
}
