{
  "name": "pi-committer",
  "version": "0.15.1",
  "description": "Reliable conventional commit automation for the pi coding agent with immutable Git snapshots and race-safe background commits",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "check:runtime": "node --check src/index.mjs && node --check src/config.mjs && node --check src/snapshot-engine.mjs && node --check src/message-engine.mjs && node --check src/worker.mjs",
    "test": "npm run typecheck && npm run check:runtime && npm run test:reliability && npm run test:legacy",
    "test:reliability": "node --test tests/reliability-v2.test.mjs tests/message-engine.test.mjs",
    "test:legacy": "node --experimental-strip-types --test tests/unit.test.ts tests/worker-edge.test.ts",
    "test:e2e": "PI_COMMITTER_E2E=1 node --test tests/e2e-v2.test.mjs",
    "test:all": "npm test && node --experimental-strip-types --test tests/defer.test.ts tests/benchmark.test.ts",
    "benchmark": "node --experimental-strip-types --test tests/benchmark.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "author": "pi-committer contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tmonk/pi-committer.git"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "git",
    "conventional-commits",
    "automation"
  ],
  "dependencies": {
    "@earendil-works/pi-tui": "^0.84.1",
    "smol-toml": "^1.3.0",
    "typebox": "^1.3.12"
  },
  "pi": {
    "extensions": [
      "./src/index.mjs"
    ],
    "image": "https://github.com/tmonk/pi-committer/raw/main/screenshot.png"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@types/node": "^25.9.5",
    "typescript": "^5.9.3"
  }
}
